# Planned production origin. scantapreviews.com has not been purchased yet;
# do not set this in Vercel until domain ownership and HTTPS are verified.
NEXT_PUBLIC_SITE_URL=https://scantapreviews.com

# Planned public mailbox. Keep this commented until inbound and outbound
# delivery have both been tested.
# SCANTAP_CONTACT_EMAIL=contact@scantapreviews.com

# Supabase Auth and Data API. The publishable key is safe for the browser;
# authorization remains enforced through Row Level Security.
# Planned production value: https://api.scantapreviews.com
# Keep it unset until Oracle, DNS, TLS, backups, and live RLS tests pass.
# NEXT_PUBLIC_SUPABASE_URL=https://api.scantapreviews.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Google Business Profile OAuth. Access also requires Google API approval.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://scantapreviews.com/api/integrations/google/callback

# Protects scheduled synchronization routes.
CRON_SECRET=
