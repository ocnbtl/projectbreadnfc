# Set this to the public Scantap domain before launch.
NEXT_PUBLIC_SITE_URL=https://projectbreadnfc.vercel.app

# Supabase Auth and Data API. The publishable key is safe for the browser;
# authorization remains enforced through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Google Business Profile OAuth. Access also requires Google API approval.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://projectbreadnfc.vercel.app/api/integrations/google/callback

# Protects scheduled synchronization routes.
CRON_SECRET=
