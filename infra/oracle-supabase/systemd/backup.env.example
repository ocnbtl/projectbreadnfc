# Install as /etc/scantap/backup.env with root:root ownership and mode 0600.
# The age recipient is public. Keep its private identity OFF the Oracle VM.
SCANTAP_SUPABASE_DIR=/srv/scantap/supabase-project
SCANTAP_BACKUP_DIR=/srv/scantap/backups
SCANTAP_BACKUP_CONFIRM=BACK UP SCANTAP
SCANTAP_BACKUP_AGE_RECIPIENT=
SCANTAP_BACKUP_RCLONE_REMOTE=
