# Merge these non-secret values into the official generated self-hosted
# Supabase .env only after scantapreviews.com is purchased and DNS is ready.
# This is not a complete Supabase environment file.

SUPABASE_PUBLIC_URL=https://api.scantapreviews.com
API_EXTERNAL_URL=https://api.scantapreviews.com/auth/v1
SITE_URL=https://scantapreviews.com
PROXY_DOMAIN=api.scantapreviews.com

# Production SMTP remains blank until a provider and sending domain are
# verified. Generate/store these only in the root-owned server .env.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Scantap
